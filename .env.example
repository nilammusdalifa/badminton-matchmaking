## Firebase config for live session sharing (view-only Player link + Umpire
## PIN join). Copy this file to `.env.local` and fill in real values from the
## Firebase Console (Project settings > Your apps > SDK setup). Without these,
## the app still works fully as a local, single-device session — sharing and
## remote scoring just won't be available.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

## Optional: Firebase App Check (reCAPTCHA v3 site key). Leave empty for local
## dev and tests; the app then skips App Check entirely. Set it only on the
## hosted build, after registering the key (see "App Check" in
## docs/superpowers/specs/2026-11-01-umpire-pin-rules-checklist.md).
VITE_APPCHECK_SITE_KEY=
